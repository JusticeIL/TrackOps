root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

# Course coding standard: tabs for indentation, explicit types, braces always.
[*.cs]
indent_style = tab
tab_width = 4
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
csharp_prefer_braces = true:warning
dotnet_sort_system_directives_first = true

[*.{csproj,props,json,yaml,yml}]
indent_style = space
indent_size = 2

# Generated by EF Core; the course style rules do not apply to generated code.
[**/Migrations/*.cs]
generated_code = true
indent_style = space
