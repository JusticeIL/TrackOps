# Gateway: the only container with a published port.
# /api/ goes to the two API replicas (round-robin); everything else is the React app.

upstream trackops_api {
    server backend-1:8080 max_fails=2 fail_timeout=5s;
    server backend-2:8080 max_fails=2 fail_timeout=5s;
    keepalive 16;
}

server {
    listen 8080;
    server_tokens off;
    client_max_body_size 64k;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    location /api/ {
        proxy_pass http://trackops_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $http_host;
        # Overwrite, never append: a client cannot spoof the address used for rate limiting.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        # Try the other replica only when this one could not be reached at all.
        # A request that reached a replica is never sent twice by the gateway.
        proxy_next_upstream error timeout;
        proxy_next_upstream_tries 2;
    }

    # Health endpoints are for containers, not for the outside.
    location /health/ {
        return 404;
    }

    location / {
        proxy_pass http://frontend:8080;
        proxy_set_header Host $http_host;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Strict-Transport-Security "${HSTS_HEADER_VALUE}" always;
    }
}
