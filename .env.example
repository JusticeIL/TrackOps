# Copy to .env and replace every CHANGE_ME value. .env is gitignored; never commit it.
# Generate a secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# SQL Server licence: setting Y means you accept Microsoft's EULA for the Developer edition image.
ACCEPT_EULA=CHANGE_ME_TO_Y

# SQL Server admin password. Used only by the database container and the one-shot migrator.
# SQL Server requires 8+ characters with upper case, lower case, digits and symbols.
MSSQL_SA_PASSWORD=CHANGE_ME

# Least-privilege login the API uses (read/write on data, no schema rights). The migrator creates it.
APP_DB_LOGIN=trackops_app
APP_DB_PASSWORD=CHANGE_ME

# Redis password (sessions, rate limits, cache).
REDIS_PASSWORD=CHANGE_ME

# Signing key for the session JWT (32+ characters) and for CSRF tokens (32+ characters).
JWT_KEY=CHANGE_ME
CSRF_KEY=CHANGE_ME

# Local runs use plain HTTP, so the cookie Secure flag and HSTS are switched off here.
# In production leave REQUIRE_HTTPS unset (it defaults to true) and set HSTS_HEADER_VALUE.
REQUIRE_HTTPS=false
HSTS_HEADER_VALUE=

# Where the app is opened in the browser, and the host port of the gateway.
PUBLIC_ORIGIN=http://localhost:8080
PUBLIC_PORT=8080

# Business rules.
DAILY_TARGET_MINUTES=480
MAX_SHIFT_HOURS=16
