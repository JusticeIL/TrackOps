" as="geometry"/></mxCell><mxCell id="map-169" value="GET" style="rounded=1;arcSize=50;html=1;fontSize=11;fontStyle=1;strokeColor=none;fontColor=#FFFFFF;fillColor=#1D6FB8;" vertex="1" parent="1"><mxGeometry x="100" y="1390" width="60" height="22" as="geometry"/></mxCell><mxCell id="map-170" value="/live" style="text;html=1;verticalAlign=middle;align=left;fontFamily=Courier New;fontSize=13;fontStyle=1;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="170" y="1384" width="430" height="34" as="geometry"/></mxCell><mxCell id="map-171" value="# Liveness probe" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="610" y="1384" width="326" height="34" as="geometry"/></mxCell><mxCell id="map-172" value="Internal" style="rounded=1;arcSize=30;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#8A8A8A;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="946" y="1390" width="84" height="22" as="geometry"/></mxCell><mxCell id="map-173" value="200" style="text;html=1;verticalAlign=middle;align=right;fontFamily=Courier New;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1040" y="1384" width="166" height="34" as="geometry"/></mxCell><mxCell id="map-174" value="" style="html=1;fillColor=#9A9A9A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1400" width="26" height="2" as="geometry"/></mxCell><mxCell id="map-175" value="GET" style="rounded=1;arcSize=50;html=1;fontSize=11;fontStyle=1;strokeColor=none;fontColor=#FFFFFF;fillColor=#1D6FB8;" vertex="1" parent="1"><mxGeometry x="100" y="1436" width="60" height="22" as="geometry"/></mxCell><mxCell id="map-176" value="/ready" style="text;html=1;verticalAlign=middle;align=left;fontFamily=Courier New;fontSize=13;fontStyle=1;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="170" y="1430" width="430" height="34" as="geometry"/></mxCell><mxCell id="map-177" value="# Readiness probe" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="610" y="1430" width="326" height="34" as="geometry"/></mxCell><mxCell id="map-178" value="Internal" style="rounded=1;arcSize=30;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#8A8A8A;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="946" y="1436" width="84" height="22" as="geometry"/></mxCell><mxCell id="map-179" value="200" style="text;html=1;verticalAlign=middle;align=right;fontFamily=Courier New;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1040" y="1430" width="166" height="34" as="geometry"/></mxCell><mxCell id="map-180" value="" style="html=1;fillColor=#9A9A9A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="70" y="1446" width="26" height="2" as="geometry"/></mxCell><mxCell id="map-181" value="" style="html=1;fillColor=#9A9A9A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="69" y="1368" width="2" height="80" as="geometry"/></mxCell><mxCell id="map-182" value="&lt;b&gt;QUERY&lt;/b&gt; (RFC 10008) is safe and idempotent and carries the filter as a JSON body: no personal data in the URL, no CSRF token needed.&lt;br&gt;&lt;b&gt;No POST fallback by design:&lt;/b&gt; a proxy or client that rejects QUERY cannot search. Known limit, recorded in DECISIONS.md." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;spacingLeft=14;spacingRight=14;fontSize=12;fillColor=#E6F5F5;strokeColor=#5AC2C5;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="30" y="1504" width="1200" height="56" as="geometry"/></mxCell><mxCell id="map-183" value="" style="rounded=1;arcSize=8;html=1;fillColor=#FFFFFF;strokeColor=#E2E2E2;shadow=1;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="30" y="1580" width="1200" height="146" as="geometry"/></mxCell><mxCell id="map-184" value="LEGEND" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontStyle=1;fontColor=#1F6F72;" vertex="1" parent="map-183"><mxGeometry x="16" y="12" width="70" height="26" as="geometry"/></mxCell><mxCell id="map-185" value="Methods" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontColor=#444444;" vertex="1" parent="map-183"><mxGeometry x="100" y="12" width="60" height="26" as="geometry"/></mxCell><mxCell id="map-186" value="GET" style="rounded=1;arcSize=50;html=1;fontSize=11;fontStyle=1;strokeColor=none;fontColor=#FFFFFF;fillColor=#1D6FB8;" vertex="1" parent="map-183"><mxGeometry x="166" y="14" width="60" height="22" as="geometry"/></mxCell><mxCell id="map-187" value="POST" style="rounded=1;arcSize=50;html=1;fontSize=11;fontStyle=1;strokeColor=none;fontColor=#FFFFFF;fillColor=#1E7F3E;" vertex="1" parent="map-183"><mxGeometry x="236" y="14" width="60" height="22" as="geometry"/></mxCell><mxCell id="map-188" value="PATCH" style="rounded=1;arcSize=50;html=1;fontSize=11;fontStyle=1;strokeColor=none;fontColor=#FFFFFF;fillColor=#7A4FBF;" vertex="1" parent="map-183"><mxGeometry x="306" y="14" width="60" height="22" as="geometry"/></mxCell><mxCell id="map-189" value="DELETE" style="rounded=1;arcSize=50;html=1;fontSize=11;fontStyle=1;strokeColor=none;fontColor=#FFFFFF;fillColor=#C2362B;" vertex="1" parent="map-183"><mxGeometry x="376" y="14" width="60" height="22" as="geometry"/></mxCell><mxCell id="map-190" value="QUERY" style="rounded=1;arcSize=50;html=1;fontSize=11;fontStyle=1;strokeColor=#0A0A0A;fontColor=#0A0A0A;fillColor=#5AC2C5;" vertex="1" parent="map-183"><mxGeometry x="446" y="14" width="60" height="22" as="geometry"/></mxCell><mxCell id="map-191" value="PUT" style="rounded=1;arcSize=50;html=1;fontSize=11;fontStyle=1;strokeColor=none;fontColor=#FFFFFF;fillColor=#9A5B00;" vertex="1" parent="map-183"><mxGeometry x="540" y="14" width="60" height="22" as="geometry"/></mxCell><mxCell id="map-192" value="not used in v1" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontColor=#444444;" vertex="1" parent="map-183"><mxGeometry x="606" y="12" width="100" height="26" as="geometry"/></mxCell><mxCell id="map-193" value="/folder" style="rounded=1;arcSize=30;html=1;fontFamily=Courier New;fontSize=13;fontStyle=1;fillColor=#0A0A0A;strokeColor=none;fontColor=#FAFAFA;" vertex="1" parent="map-183"><mxGeometry x="740" y="12" width="84" height="26" as="geometry"/></mxCell><mxCell id="map-194" value="a path segment; each leaf adds its own path" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontColor=#444444;" vertex="1" parent="map-183"><mxGeometry x="834" y="12" width="350" height="26" as="geometry"/></mxCell><mxCell id="map-195" value="Roles" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontColor=#444444;" vertex="1" parent="map-183"><mxGeometry x="100" y="46" width="60" height="26" as="geometry"/></mxCell><mxCell id="map-196" value="Public" style="rounded=1;arcSize=30;html=1;fontSize=11;fillColor=#EFEFEF;strokeColor=#BDBDBD;fontColor=#0A0A0A;" vertex="1" parent="map-183"><mxGeometry x="166" y="48" width="84" height="22" as="geometry"/></mxCell><mxCell id="map-197" value="Employee" style="rounded=1;arcSize=30;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#0A0A0A;fontColor=#0A0A0A;" vertex="1" parent="map-183"><mxGeometry x="260" y="48" width="84" height="22" as="geometry"/></mxCell><mxCell id="map-198" value="Manager" style="rounded=1;arcSize=30;html=1;fontSize=11;fontStyle=1;fillColor=#0A0A0A;strokeColor=#0A0A0A;fontColor=#5AC2C5;" vertex="1" parent="map-183"><mxGeometry x="354" y="48" width="84" height="22" as="geometry"/></mxCell><mxCell id="map-199" value="Internal" style="rounded=1;arcSize=30;html=1;fontSize=11;fillColor=#FFFFFF;strokeColor=#8A8A8A;dashed=1;fontColor=#444444;" vertex="1" parent="map-183"><mxGeometry x="448" y="48" width="84" height="22" as="geometry"/></mxCell><mxCell id="map-200" value="Employee = any signed-in user, managers included  ·  Internal = reachable by containers only" style="text;html=1;verticalAlign=middle;align=left;fontSize=12;fontColor=#444444;" vertex="1" parent="map-183"><mxGeometry x="552" y="46" width="632" height="26" as="geometry"/></mxCell><mxCell id="map-201" value="&lt;b&gt;★ Recording endpoint:&lt;/b&gt; requires an Idempotency-Key header; its timestamp comes only from the external time API, and it returns 503 when that source is unavailable (fail closed).&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;Any Employee or Manager endpoint may also return 401 or 429.&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;POST, PATCH and DELETE require the X-CSRF-Token header, otherwise 403." style="text;html=1;verticalAlign=middle;whiteSpace=wrap;align=left;fontSize=12;fontColor=#444444;" vertex="1" parent="map-183"><mxGeometry x="16" y="82" width="1168" height="52" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="flow" name="Clock-in flow"><mxGraphModel adaptiveColors="none" background="#FAFAFA" page="0" grid="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-1" value="Clock-in flow" style="text;html=1;verticalAlign=middle;align=left;fontSize=28;fontStyle=1;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="300" height="40" as="geometry"/></mxCell><mxCell id="flow-2" value="POST /api/v1/shifts" style="rounded=1;arcSize=30;html=1;fontFamily=Courier New;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#0A0A0A;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="800" y="24" width="220" height="32" as="geometry"/></mxCell><mxCell id="flow-3" value="Every check runs on any replica; shared state lives only in Redis and SQL Server. The recorded timestamp never comes from the browser or the server clock." style="text;html=1;verticalAlign=middle;align=left;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="30" y="62" width="990" height="24" as="geometry"/></mxCell><mxCell id="flow-4" value="&lt;b&gt;1 · Browser sends the request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cookies (JWT + session id) · X-CSRF-Token · Idempotency-Key&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;shadow=1;fontColor=#FAFAFA;fillColor=#0A0A0A;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="380" height="60" as="geometry"/></mxCell><mxCell id="flow-5" value="&lt;b&gt;2 · nginx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;forwards to replica 1 or 2&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;shadow=1;fontColor=#0A0A0A;fillColor=#FFFFFF;strokeColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="260" y="202" width="380" height="60" as="geometry"/></mxCell><mxCell id="flow-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A0A0A;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#0A0A0A;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="flow-4" target="flow-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-7" value="&lt;b&gt;3 · CSRF check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;header token must match the CSRF cookie&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;shadow=1;fontColor=#0A0A0A;fillColor=#FFFFFF;strokeColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="260" y="294" width="380" height="60" as="geometry"/></mxCell><mxCell id="flow-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A0A0A;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#0A0A0A;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="flow-5" target="flow-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-9" value="&lt;b&gt;403&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;csrf_invalid&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FDECEC;strokeColor=#C2362B;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="770" y="300" width="250" height="48" as="geometry"/></mxCell><mxCell id="flow-10" value="mismatch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C2362B;strokeWidth=1.5;endArrow=block;fontSize=11;fontColor=#C2362B;verticalAlign=bottom;" edge="1" parent="1" source="flow-7" target="flow-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-11" value="&lt;b&gt;4 · JWT + session check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;signature · expiry · sid claim = cookie = live Redis session&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;shadow=1;fontColor=#0A0A0A;fillColor=#FFFFFF;strokeColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="260" y="386" width="380" height="60" as="geometry"/></mxCell><mxCell id="flow-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A0A0A;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#0A0A0A;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="flow-7" target="flow-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-13" value="Redis" style="rounded=1;arcSize=40;html=1;fontSize=12;fontStyle=1;fillColor=#0A0A0A;strokeColor=none;fontColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="30" y="398" width="150" height="36" as="geometry"/></mxCell><mxCell id="flow-14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#8A8A8A;" edge="1" parent="1" source="flow-13" target="flow-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-15" value="&lt;b&gt;401&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;unauthenticated&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FDECEC;strokeColor=#C2362B;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="770" y="392" width="250" height="48" as="geometry"/></mxCell><mxCell id="flow-16" value="invalid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C2362B;strokeWidth=1.5;endArrow=block;fontSize=11;fontColor=#C2362B;verticalAlign=bottom;" edge="1" parent="1" source="flow-11" target="flow-15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-17" value="&lt;b&gt;5 · Rate limit&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;per-user counter shared by both replicas&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;shadow=1;fontColor=#0A0A0A;fillColor=#FFFFFF;strokeColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="260" y="478" width="380" height="60" as="geometry"/></mxCell><mxCell id="flow-18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A0A0A;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#0A0A0A;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="flow-11" target="flow-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-19" value="Redis" style="rounded=1;arcSize=40;html=1;fontSize=12;fontStyle=1;fillColor=#0A0A0A;strokeColor=none;fontColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="30" y="490" width="150" height="36" as="geometry"/></mxCell><mxCell id="flow-20" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#8A8A8A;" edge="1" parent="1" source="flow-19" target="flow-17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-21" value="&lt;b&gt;429&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;rate_limited + Retry-After&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#FDECEC;strokeColor=#C2362B;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="770" y="484" width="250" height="48" as="geometry"/></mxCell><mxCell id="flow-22" value="over limit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C2362B;strokeWidth=1.5;endArrow=block;fontSize=11;fontColor=#C2362B;verticalAlign=bottom;" edge="1" parent="1" source="flow-17" target="flow-21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-23" value="&lt;b&gt;6 · Idempotency-Key lookup&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;has this user already sent this key?&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;shadow=1;fontColor=#0A0A0A;fillColor=#FFFFFF;strokeColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="260" y="570" width="380" height="60" as="geometry"/></mxCell><mxCell id="flow-24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0A0A0A;strokeWidth=2;endArrow=block;fontSize=11;fontColor=#0A0A0A;labelBackgroundColor=#FAFAFA;" edge="1" parent="1" source="flow-17" target="flow-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-25" value="SQL Server" style="rounded=1;arcSize=40;html=1;fontSize=12;fontStyle=1;fillColor=#0A0A0A;strokeColor=none;fontColor=#FAFAFA;" vertex="1" parent="1"><mxGeometry x="30" y="582" width="150" height="36" as="geometry"/></mxCell><mxCell id="flow-26" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#8A8A8A;" edge="1" parent="1" source="flow-25" target="flow-23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-27" value="&lt;b&gt;Replay stored response&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;same 201 · no second shift&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=12;fillColor=#E6F5F5;strokeColor=#1F6F72;fontColor=#0A0A0A;" vertex="1" parent="1"><mxGeometry x="770" y="576" width="250" height="48" as="geometry"/></mxCell><mxCell id="flow-28" value="seen before" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1F6F72;strokeWidth=1.5;endArrow=block;fontSize=11;fontColor=#1F6F72;verticalAlign=bottom;" edge="1" parent="1" source="flow-23" target="flow-27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="flow-29" value="&lt;b&gt;7 · Fetch Zurich time&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;short timeout · one retry · second provider · circuit breaker&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontSize=13;shadow=1;fontColor=#0A0A0A;fillColor=#FFFFFF;strokeCol